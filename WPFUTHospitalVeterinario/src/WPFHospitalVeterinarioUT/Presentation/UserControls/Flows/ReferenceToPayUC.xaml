<bases:AppUserControl
    x:Class="Presentation.UserControls.Flows.ReferenceToPayUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bases="clr-namespace:UI.Bases"
    xmlns:components="clr-namespace:UI.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:modals="clr-namespace:UI.Modals"
    d:DataContext="{d:DesignInstance Type=modals:ModalViewModel}"
    d:DesignHeight="1920"
    d:DesignWidth="1080"
    mc:Ignorable="d">
    <Viewbox Stretch="Uniform">
        <Grid Width="1080" Height="1920">
            <Grid.Background>
                <ImageBrush ImageSource="{StaticResource REFERENCIAPAGO}" />
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="0.7*" />
            </Grid.RowDefinitions>
            <materialDesign:PackIcon
                Width="117"
                Height="48"
                Margin="619,206,0,0"
                Foreground="White"
                Kind="ClockTimeTwoOutline"
                RenderTransformOrigin="0.5,0.5">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <SkewTransform />
                        <RotateTransform Angle="-8.523" />
                        <TranslateTransform />
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
            <TextBlock
                x:Name="TxtTimer"
                Width="164"
                Height="54"
                Margin="0,204,204,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                d:Text="01:25"
                FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                FontSize="45"
                Foreground="{StaticResource BACK}" />
            <Border Grid.Row="0">
                <Grid>
                    <Grid
                        Width="100"
                        Height="100"
                        Margin="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                        <Image
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            MouseDown="BtnAtras_MouseDown"
                            Source="{StaticResource backIcons}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="{StaticResource TEXTCOLOR}">
                            Ir Atrás
                        </TextBlock>
                    </Grid>
                    <Grid
                        Width="100"
                        Height="100"
                        Margin="20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                        <Image
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            MouseDown="BtnSalir_MouseDown"
                            Source="{StaticResource exitIcons}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="{StaticResource TEXTCOLOR}"
                            TextAlignment="Right">
                            Salir
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Row="1">
                <StackPanel Margin="220,0,211,-66" Orientation="Vertical">
                    <StackPanel Height="50" />
                    <TextBlock
                        x:Name="nameUser"
                        Height="70"
                        FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                        FontSize="50"
                        FontWeight="Bold"
                        Foreground="{StaticResource TITLECOLOR}"
                        TextAlignment="Center">
                        Hola, nombre
                    </TextBlock>
                    <TextBlock
                        Height="66"
                        FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                        FontSize="33"
                        FontWeight="Bold"
                        Foreground="{StaticResource TITLECOLOR}"
                        TextAlignment="Center">
                        Digita la referencia y el valor a pagar
                    </TextBlock>
                    <StackPanel Margin="10,50,10,0" Orientation="Horizontal">
                        <Image
                            Width="82"
                            Height="50"
                            Margin="10,0,0,0"
                            RenderTransformOrigin="0.5,0.5"
                            Source="{StaticResource acceptorIcons}">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="-1" />
                                    <SkewTransform />
                                    <RotateTransform />
                                    <TranslateTransform />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <TextBlock
                            Height="40"
                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                            FontSize="30"
                            Foreground="{StaticResource TEXTCOLOR}"
                            TextAlignment="Center"><Run Text="Referencia de pago" /></TextBlock>

                    </StackPanel>
                    <Border
                        Width="600"
                        Height="100"
                        Margin="0,10,0,0"
                        Background="{StaticResource BACK}"
                        CornerRadius="15">
                        <!--<TextBox x:Name="references" Margin="10,0,10,0" Style="{StaticResource TextBoxStyleTwo}" TextAlignment="Center" CaretBrush="Transparent" BorderBrush="Transparent"/>-->
                        <TextBox
                            x:Name="references"
                            Width="560"
                            Height="90"
                            Padding="5"
                            VerticalContentAlignment="Center"
                            Background="{StaticResource BACK}"
                            BorderBrush="{StaticResource BACK}"
                            CaretBrush="Transparent"
                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                            FontSize="40"
                            Foreground="{StaticResource TEXTCOLOR}"
                            TextAlignment="Center" />
                    </Border>
                    <StackPanel Margin="0,45,0,0" Orientation="Horizontal">
                        <Image
                            Width="90"
                            Height="51"
                            Margin="10,0,0,0"                         
                            Source="{StaticResource moneyIcons}" />
                        <TextBlock
                            Height="42"
                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                            FontSize="30"
                            Foreground="{StaticResource TEXTCOLOR}"
                            TextAlignment="Center"><Run Text="Valor a pagar" /></TextBlock>

                    </StackPanel>
                    <Border
                        Width="600"
                        Margin="0,10,0,0"
                        Background="{StaticResource BACK}"
                        CornerRadius="15">

                        <TextBox
                            x:Name="InputInvoice"
                            Margin="5,0,5,0"
                            IsHitTestVisible="False"
                            Style="{StaticResource TextBoxStyleTwo}"
                            TextAlignment="Center"
                            TextChanged="TxtInvoice_TextChanged" />
                    </Border>
                    <components:NumericKeyboard
                        x:Name="Keyboard"
                        Width="348"
                        Height="404"
                        Margin="0,80,0,0" />
                </StackPanel>
            </Border>
            <Border
                Grid.Row="2"
                Width="1080"
                HorizontalAlignment="Left">
                <Grid Margin="0,80,0,0" HorizontalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="50" />
                        <!--  separación  -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Cancelar  -->
                    <Image
                        Width="300"
                        Height="90"
                        Margin="0,41,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        MouseDown="BtnSalir_MouseDown"
                        Source="{StaticResource cancelButtons}" />

                    <!--  Pagar  -->
                    <Image
                        Grid.Column="2"
                        Width="300"
                        Height="90"
                        Margin="0,41,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        MouseDown="BtnReferenceToPay_MouseDown"
                        Source="{StaticResource payButtons}" />

                </Grid>

            </Border>
            <Image
                Grid.Row="2"
                Margin="727,253,36,22"
                RenderTransformOrigin="-0.49,-1.922"
                Source="/Assets/Images/Logos/LogoDev.png"
                Stretch="Fill" />
            <Image
                Grid.Row="2"
                Margin="36,256,792,24"
                Source="/Assets/Images/Logos/ico_linea_atencion_kiscos.png"
                Stretch="Fill" />

        </Grid>
    </Viewbox>
</bases:AppUserControl>