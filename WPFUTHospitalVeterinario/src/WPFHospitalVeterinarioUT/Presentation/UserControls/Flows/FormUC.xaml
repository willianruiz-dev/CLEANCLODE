<bases:AppUserControl
    x:Class="Presentation.UserControls.Flows.FormUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bases="clr-namespace:UI.Bases"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:keyboard="clr-namespace:VirtualKeyboard.Wpf"
    xmlns:local="clr-namespace:Presentation.UserControls.Flows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1920"
    d:DesignWidth="1080"
    mc:Ignorable="d">

    <Viewbox Stretch="Uniform">

        <Grid Width="1080" Height="1920">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="1.7*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Background>
                <ImageBrush ImageSource="{StaticResource FORMULARIO}" />
            </Grid.Background>
            <materialDesign:PackIcon
                Width="117"
                Height="48"
                Margin="619,206,0,0"
                Foreground="White"
                Kind="ClockTimeTwoOutline"
                RenderTransformOrigin="0.5,0.5">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <SkewTransform />
                        <RotateTransform Angle="-8.523" />
                        <TranslateTransform />
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
            <TextBlock
                x:Name="TxtTimer"
                Width="164"
                Height="54"
                Margin="0,204,204,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                d:Text="01:25"
                FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                FontSize="45"
                Foreground="{StaticResource BACK}" />
            <Border Grid.Row="0">
                <Grid>
                    <Grid
                        Width="100"
                        Height="100"
                        Margin="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                        <Image
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            MouseDown="BtnAtras_MouseDown"
                            Source="{StaticResource backIcons}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="{StaticResource TEXTCOLOR}">
                            Ir Atrás
                        </TextBlock>
                    </Grid>
                    <Grid
                        Width="100"
                        Height="100"
                        Margin="20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                        <Image
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            MouseDown="BtnSalir_MouseDown"
                            Source="{StaticResource exitIcons}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="{StaticResource TEXTCOLOR}"
                            TextAlignment="Right">
                            Salir
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
            <Border
                Grid.Row="1"
                Grid.RowSpan="2"
                Height="1000"
                VerticalAlignment="Top">

                <StackPanel Orientation="Vertical">
                    <TextBlock
                        x:Name="INFO"
                        Width="1080"
                        Height="92"
                        Margin="0,85,0,20"
                        Background="{x:Null}"
                        FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                        FontSize="53"
                        FontWeight="Bold"
                        Foreground="{StaticResource TEXTCOLOR}"
                        Text="Diligenciar el Formulario"
                        TextAlignment="Center"
                        TextWrapping="wrap" />

                    <StackPanel
                        Width="700"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">

                        <Grid Width="330" Margin="10,0,0,0">
                            <StackPanel Orientation="Vertical">
                                <Label
                                    Width="330"
                                    Padding="10"
                                    FontFamily="{StaticResource CENTURY_GOTHIC}"
                                    FontSize="30"
                                    Foreground="{StaticResource TEXTCOLOR}">
                                    Tipo de documento*
                                </Label>
                                <Border
                                    Padding="5"
                                    Background="{StaticResource BACK}"
                                    CornerRadius="5">
                                    <ComboBox
                                        x:Name="TypeDocument"
                                        Width="300"
                                        Height="70"
                                        Padding="10"
                                        materialDesign:HintAssist.Hint="Seleccionar"
                                        materialDesign:HintAssist.HintOpacity="1"
                                        BorderBrush="{StaticResource BACK}"
                                        FontFamily="{StaticResource CENTURY_GOTHIC}"
                                        FontSize="20"
                                        Foreground="{StaticResource TEXTCOLOR}"
                                        SelectionChanged="OnSelectionChanged"
                                        Style="{StaticResource MaterialDesignComboBox}">
                                        <ComboBoxItem
                                            Width="276"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Content="Cédula de Ciudadanía"
                                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                                            FontSize="20"
                                            Foreground="{StaticResource TEXTCOLOR}"
                                            Tag="1" />
                                        <ComboBoxItem
                                            Width="276"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Content="Tarjeta de Identidad"
                                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                                            FontSize="20"
                                            Foreground="{StaticResource TEXTCOLOR}"
                                            Tag="2" />
                                        <ComboBoxItem
                                            Width="276"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Content="Registro Civil"
                                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                                            FontSize="20"
                                            Foreground="{StaticResource TEXTCOLOR}"
                                            Tag="3" />
                                        <ComboBoxItem
                                            Width="276"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Content="Cédula de Extranjería"
                                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                                            FontSize="20"
                                            Foreground="{StaticResource TEXTCOLOR}"
                                            Tag="4" />
                                    </ComboBox>
                                </Border>
                            </StackPanel>
                            <Image
                                Width="20"
                                Height="20"
                                Margin="0,55,20,0"
                                HorizontalAlignment="Right"
                                IsHitTestVisible="False"
                                Source="{StaticResource comboboxImage}" />

                        </Grid>
                        <StackPanel
                            Width="340"
                            Margin="10,0,0,0"
                            Orientation="Vertical">

                            <Label
                                Width="354"
                                Padding="10"
                                HorizontalAlignment="Left"
                                FontFamily="{StaticResource CENTURY_GOTHIC}"
                                FontSize="30"
                                Foreground="{StaticResource TEXTCOLOR}">
                                Número documento*
                            </Label>
                            <Border
                                Padding="5"
                                Background="{StaticResource BACK}"
                                CornerRadius="5">
                                <TextBox
                                    Width="320"
                                    Height="70"
                                    Padding="10"
                                    VerticalContentAlignment="Center"
                                    Background="{StaticResource BACK}"
                                    BorderBrush="{StaticResource BACK}"
                                    CaretBrush="Transparent"
                                    FontFamily="{StaticResource CENTURY_GOTHIC}"
                                    FontSize="27"
                                    Foreground="{StaticResource TEXTCOLOR}"
                                    Text="{Binding Document, Mode=TwoWay}"
                                    TextChanged="TxtDocument_TextChanged" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel
                        Width="680"
                        Margin="0,0,0,0"
                        d:IsLocked="True"
                        Orientation="Vertical">
                        <Label
                            Width="681"
                            Margin="0,20,0,0"
                            Content="Nombres*"
                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                            FontSize="30"
                            Foreground="Black" />
                        <Border
                            Margin="0,0,0,0"
                            Padding="5"
                            Background="{StaticResource BACK}"
                            BorderBrush="{StaticResource BACK}"
                            CornerRadius="5">
                            <TextBox
                                CaretBrush="Transparent"
                                Style="{StaticResource TextBoxStyle}"
                                Text="{Binding FirstName, Mode=TwoWay}"
                                TextChanged="TxtFirstName_TextChanged" />
                        </Border>
                    </StackPanel>

                    <StackPanel
                        Width="680"
                        Margin="0,0,0,0"
                        Orientation="Vertical">
                        <Label
                            Width="681"
                            Margin="0,20,0,0"
                            Content="Apellidos*"
                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                            FontSize="30"
                            Foreground="{StaticResource TEXTCOLOR}" />
                        <Border
                            Padding="5"
                            Background="{StaticResource BACK}"
                            CornerRadius="5">
                            <TextBox
                                CaretBrush="Transparent"
                                Style="{StaticResource TextBoxStyle}"
                                Text="{Binding LastName, Mode=TwoWay}"
                                TextChanged="TxtLastName_TextChanged" />
                        </Border>
                    </StackPanel>

                    <StackPanel
                        Width="680"
                        Margin="0,0,0,0"
                        Orientation="Vertical">
                        <Label
                            Width="681"
                            Margin="0,20,0,0"
                            Content="Número celular*"
                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                            FontSize="30"
                            Foreground="{StaticResource TEXTCOLOR}" />
                        <Border
                            Padding="5"
                            Background="{StaticResource BACK}"
                            CornerRadius="5">
                            <TextBox
                                CaretBrush="Transparent"
                                Style="{StaticResource TextBoxStyle}"
                                Text="{Binding Mobile, Mode=TwoWay}"
                                TextChanged="TxtMobile_TextChanged" />
                        </Border>
                    </StackPanel>
                    <StackPanel
                        Width="680"
                        Margin="0,0,0,0"
                        Orientation="Vertical">
                        <Label
                            Width="681"
                            Margin="0,20,0,0"
                            Content="Correo Electronico*"
                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                            FontSize="30"
                            Foreground="{StaticResource TEXTCOLOR}" />
                        <Border
                            Padding="5"
                            Background="{StaticResource BACK}"
                            CornerRadius="5">
                            <TextBox
                                CaretBrush="Transparent"
                                Style="{StaticResource TextBoxStyle}"
                                Text="{Binding Email, Mode=TwoWay}"
                                TextChanged="TxtEmail_changed"
                                keyboard:VKeyboard.InputKind="Email" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border
                Grid.Row="2"
                Width="748"
                Margin="0,141,0,0"
                HorizontalAlignment="Center">
                <StackPanel Orientation="Vertical">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Image
                            x:Name="BtnTreatments"
                            Width="80"
                            Height="62"
                            MouseDown="BtnTreatments_MouseDown"
                            Source="{StaticResource ResourceKey=eyeIcons}" />
                        <TextBlock
                            Width="520"
                            Height="30"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                            FontSize="25"
                            Foreground="{StaticResource TEXTCOLOR}"
                            Text="Ver la Politica de tratamientos de datos"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Margin="12,1,0,0"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                        <Label
                            Width="584"
                            VerticalAlignment="Center"
                            Content="Acepto la Politica de tratamientos de datos*"
                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                            FontSize="25"
                            Foreground="{StaticResource TEXTCOLOR}" />
                        <ToggleButton
                            Width="85"
                            Height="45"
                            Margin="60,0,0,0"
                            Checked="ToggleButton_Checked"
                            Style="{StaticResource CustomToggleButtonStyleTwo}"
                            ToolTip="black"
                            Unchecked="ToggleButton_Checked" />
                    </StackPanel>

                    <StackPanel
                        Width="736"
                        Margin="10,50,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <StackPanel HorizontalAlignment="Center">
                            <Image
                                Width="284"
                                Height="71"
                                MouseDown="BtnSalir_MouseDown"
                                Source="{StaticResource cancelButtons}" />
                        </StackPanel>
                        <StackPanel Width="140" />
                        <StackPanel
                            x:Name="BtnFormArea"
                            Background="Transparent"
                            MouseDown="BtnForm_MouseDown">
                            <Image
                                x:Name="BtnForm"
                                Width="284"
                                Height="71"
                                Source="{StaticResource sendButtons}"
                                Visibility="Hidden" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Image Margin="802,426,24,34" Grid.Row="2" Source="/Assets/Images/Logos/LogoDev.png" Stretch="Fill"/>
            <Image Margin="48,427,860,35" Grid.Row="2" Source="/Assets/Images/Logos/ico_linea_atencion_kiscos.png" Stretch="Fill"/>


        </Grid>


    </Viewbox>
</bases:AppUserControl>
