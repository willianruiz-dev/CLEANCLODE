<bases:AppUserControl
    x:Class="Presentation.UserControls.Flows.PaymentUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bases="clr-namespace:UI.Bases"
    xmlns:converters="clr-namespace:Presentation.Shared.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Presentation.UserControls.Flows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1920"
    d:DesignWidth="1080"
    mc:Ignorable="d">
    <bases:AppUserControl.Resources>
        <converters:MoneyConverter x:Key="MoneyConverter" />
    </bases:AppUserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Grid
            x:Name="MainGrid"
            Width="1080"
            Height="1920">
            <Grid.Background>
                <ImageBrush ImageSource="{StaticResource PAYMENT}" />
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="2.5*" />
                <RowDefinition Height="4*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" />
            <Border
                Grid.Row="1"
                Grid.RowSpan="2"
                Margin="0,0,0,64">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90" />
                        <RowDefinition Height="620" />
                        <RowDefinition Height="530" />
                        <RowDefinition Height="300" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Height="160" VerticalAlignment="Bottom">
                        <TextBlock
                            Width="500"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                            FontSize="60"
                            FontWeight="Bold"
                            Foreground="{StaticResource TEXTCOLOR}"
                            Text="Ingrese el dinero"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                    </Grid>
                    <Grid Grid.Row="1" Margin="58,70,53,0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="100" />
                            <RowDefinition Height="90*" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340*" />
                            <ColumnDefinition Width="340*" />
                            <ColumnDefinition Width="340*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Height="60"
                            Margin="50,0,0,0">
                            <Image Margin="0,0,0,0" Source="{StaticResource DenominationImage}" />
                        </Border>
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Height="60">
                            <Image Margin="0,0,0,0" Source="{StaticResource quantityImage}" />
                        </Border>
                        <Border
                            Grid.Row="0"
                            Grid.Column="2"
                            Height="60"
                            Margin="0,0,50,0">
                            <Image Margin="0,0,0,0" Source="{StaticResource totalImage}" />
                        </Border>
                        <ListBox
                            x:Name="DataView"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Width="847"
                            HorizontalAlignment="Center">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Width="810"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Columna Denominación  -->
                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="5"
                                            HorizontalAlignment="Left"
                                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                                            Foreground="{StaticResource TEXTCOLOR}"
                                            Style="{StaticResource ViewBoxTextStyle}"
                                            Text="{Binding DenominationValue, Converter={StaticResource MoneyConverter}}" />
                                        <!--  Columna de Cantidad  -->
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="5"
                                            HorizontalAlignment="center"
                                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                                            Foreground="{StaticResource TEXTCOLOR}"
                                            Style="{StaticResource ViewBoxTextStyle}"
                                            Text="{Binding Quantity}" />
                                        <!--  Columna de Total  -->
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource TEXTCOLOR}"
                                            Style="{StaticResource ViewBoxTextStyle}"
                                            Text="{Binding TotalDenomAmount, Converter={StaticResource MoneyConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>



                    </Grid>
                    <Grid Grid.Row="2" Margin="58,0,53,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="0.1*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="70,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="45" />
                                <RowDefinition Height="Auto" MinHeight="45" />
                                <RowDefinition Height="Auto" MinHeight="45" />
                                <RowDefinition Height="Auto" MinHeight="65" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                FontFamily="{StaticResource CENTURY_GOTHIC}"
                                FontSize="35"
                                Foreground="{StaticResource TEXTCOLOR}"
                                VerticalAlignment="Center"
                                Text="Valor ingresado:" />
                            <TextBlock
                                Grid.Row="1"
                                FontFamily="{StaticResource CENTURY_GOTHIC}"
                                FontSize="35"
                                Foreground="{StaticResource TEXTCOLOR}"
                                VerticalAlignment="Center"
                                Text="Valor faltante:" />
                            <TextBlock
                                Grid.Row="2"
                                FontFamily="{StaticResource CENTURY_GOTHIC}"
                                FontSize="35"
                                Foreground="{StaticResource TEXTCOLOR}"
                                VerticalAlignment="Center"
                                Text="Valor sobrante:" />
                            <TextBlock
                                Grid.Row="3"
                                FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                                FontSize="40"
                                FontWeight="Bold"
                                Foreground="{StaticResource TEXTCOLOR}"
                                VerticalAlignment="Center"
                                Text="Valor total:" />
                        </Grid>

                        <Grid Grid.Column="2" Margin="0,0,30,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="45" />
                                <RowDefinition Height="Auto" MinHeight="45" />
                                <RowDefinition Height="Auto" MinHeight="45" />
                                <RowDefinition Height="Auto" MinHeight="65" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                HorizontalAlignment="Right"
                                FontFamily="{StaticResource CENTURY_GOTHIC}"
                                FontSize="35"
                                Foreground="{StaticResource TEXTCOLOR}"
                                Text="{Binding EnteredAmount, Converter={StaticResource MoneyConverter}}" />
                            <TextBlock
                                Grid.Row="1"
                                HorizontalAlignment="Right"
                                FontFamily="{StaticResource CENTURY_GOTHIC}"
                                FontSize="35"
                                Foreground="{StaticResource TEXTCOLOR}"
                                Text="{Binding RemainingAmount, Converter={StaticResource MoneyConverter}}" />
                            <TextBlock
                                Grid.Row="2"
                                HorizontalAlignment="Right"
                                FontFamily="{StaticResource CENTURY_GOTHIC}"
                                FontSize="35"
                                Foreground="{StaticResource TEXTCOLOR}"
                                Text="{Binding ReturnAmount, Converter={StaticResource MoneyConverter}}" />
                            <TextBlock
                                Grid.Row="3"
                                HorizontalAlignment="Right"
                                FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                                FontSize="40"
                                FontWeight="Bold"
                                Foreground="{StaticResource PRIMARYCOLOR}"
                                Text="{Binding PayAmount, Converter={StaticResource MoneyConverter}}" />

                        </Grid>
                    </Grid>
                    <Image
                        x:Name="BtnCancel"
                        Grid.Row="2"
                        Height="90"
                        Margin="2,358,-2,0"
                        VerticalAlignment="Top"
                        MouseDown="BtnCancel_TouchDown"
                        Source="{StaticResource cancelButtons}" />


                </Grid>


            </Border>
            <Image Margin="803,374,23,19" Grid.Row="2" Source="/Assets/Images/Logos/LogoDev.png" Stretch="Fill"/>
            <Image Margin="47,363,781,6" Grid.Row="2" Source="/Assets/Images/Logos/ico_linea_atencion_kiscos.png" Stretch="Fill"/>


        </Grid>

    </Viewbox>
</bases:AppUserControl>
