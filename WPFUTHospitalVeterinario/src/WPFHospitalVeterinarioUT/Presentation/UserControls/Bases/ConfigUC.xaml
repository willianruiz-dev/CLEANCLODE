<bases:AppUserControl
    x:Class="Presentation.UserControls.Bases.ConfigUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bases="clr-namespace:UI.Bases"
    xmlns:components="clr-namespace:UI.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1920"
    d:DesignWidth="1080"
    mc:Ignorable="d">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{StaticResource GENERIC}" />
        </Grid.Background>
        <TextBlock
            Width="900"
            Margin="0,450,0,0"
            FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
            Foreground="{StaticResource PRIMARYCOLOR}"
            Style="{StaticResource TitleStyle}"
            Text="CONFIGURACIÓN DEL DISPOSITIVO" />
        <TextBlock
            Width="900"
            Height="67"
            Margin="0,727,0,0"
            FontFamily="{StaticResource CENTURY_GOTHIC}"
            Foreground="{StaticResource TEXTCOLOR}"
            Style="{StaticResource MessageTextStyle}"
            Text="Espere mientras se configura el dispositivo para iniciar" />

        <TextBlock
            x:Name="TxtStatus"
            Margin="0,1609,0,0"
            FontWeight="Bold"
            Foreground="{StaticResource TEXTCOLOR}"
            Style="{StaticResource MessageTextStyle}"
            Text="{Binding StatusMsg}" />
        <mah:ProgressRing
            x:Name="LoadGif"
            Width="435"
            Height="402"
            Margin="0,925,0,0"
            Style="{StaticResource ProgressRingStyle}" />
        <Image Margin="803,1835,23,26" Source="/Assets/Images/Logos/LogoDev.png" Stretch="Fill"/>
        <Image Margin="48,1827,796,15" Source="/Assets/Images/Logos/ico_linea_atencion_kiscos.png" Stretch="Fill"/>


    </Grid>
</bases:AppUserControl>
