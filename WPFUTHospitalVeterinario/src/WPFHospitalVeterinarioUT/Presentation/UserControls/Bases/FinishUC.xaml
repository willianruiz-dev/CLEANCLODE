<bases:AppUserControl
    x:Class="Presentation.UserControls.Bases.FinishUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bases="clr-namespace:UI.Bases"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Presentation.UserControls.Bases"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1920"
    d:DesignWidth="1080"
    mc:Ignorable="d">
    <Viewbox Stretch="Uniform">
        <Viewbox.Resources>
            <Style x:Key="ConditionalStart" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="False">
                        <Setter Property="Source" Value="{StaticResource startButtons}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Source" Value="{StaticResource StartRedButtons}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ConditionalButton" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SendCalification}" Value="False">
                        <Setter Property="Source" Value="{StaticResource omitButtons}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SendCalification}" Value="True">
                        <Setter Property="Source" Value="{StaticResource sendButtons}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Viewbox.Resources>
        <Grid Width="1080" Height="1920">
            <Grid.Background>
                <ImageBrush ImageSource="{StaticResource FINAL}" />
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="0.3*" />
            </Grid.RowDefinitions>
            <materialDesign:PackIcon
                Width="117"
                Height="48"
                Margin="619,206,0,0"
                Foreground="White"
                Kind="ClockTimeTwoOutline"
                RenderTransformOrigin="0.5,0.5">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <SkewTransform />
                        <RotateTransform Angle="-8.523" />
                        <TranslateTransform />
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
            <TextBlock
                x:Name="TxtTimer"
                Width="164"
                Height="54"
                Margin="0,204,204,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                d:Text="01:25"
                FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                FontSize="45"
                Foreground="{StaticResource BACK}" />

            <Grid Grid.Row="1" Margin="174,0,166,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1*" />


                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.5*" />
                            <RowDefinition Height="2*" />

                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="nameUser"
                            Grid.Row="0"
                            FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                            FontSize="50"
                            FontStyle="Normal"
                            FontWeight="Bold"
                            Foreground="{StaticResource TITLECOLOR}"
                            TextAlignment="Center">
                            Feliz día Nombre,
                        </TextBlock>
                        <Grid
                            Grid.Row="1"
                            Grid.RowSpan="3"
                            Margin="0,0,0,0">
                            <TextBlock
                                FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                                FontSize="80"
                                FontWeight="Bold"
                                Foreground="{StaticResource PRIMARYCOLOR}"
                                TextAlignment="Center">
                                Gracias
                            </TextBlock>

                        </Grid>

                    </Grid>
                </Grid>
                <Grid
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock
                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                            FontSize="35"
                            FontWeight="Medium"
                            Foreground="#2a303b">
                            por utilizar nuestros servicios
                        </TextBlock>
                        <TextBlock
                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                            FontSize="35"
                            Foreground="#2b2f34"
                            TextAlignment="Center">
                            nos vemos pronto
                        </TextBlock>

                    </StackPanel>
                </Grid>
                <Grid
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom">
                    <Line
                        Stroke="Black"
                        StrokeThickness="1"
                        X1="10"
                        X2="330"
                        Y1="10"
                        Y2="10" />

                </Grid>
                <Grid
                    Grid.Row="2"
                    Grid.RowSpan="2"
                    Margin="60"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom">
                    <Image Source="{StaticResource qualificationImages}" />
                </Grid>
                <Grid
                    Grid.Row="3"
                    Grid.RowSpan="2"
                    Margin="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical">
                        <TextBlock
                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                            FontSize="35"
                            Foreground="{StaticResource TEXTCOLOR}"
                            TextAlignment="Center">
                            Califica tu experiencia con
                        </TextBlock>
                        <TextBlock
                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                            FontSize="35"
                            Foreground="{StaticResource TEXTCOLOR}"
                            TextAlignment="Center">
                            nuestro módulo de pagos.
                        </TextBlock>

                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="4"
                    Grid.RowSpan="3"
                    Height="336"
                    Margin="50,100,50,0"
                    VerticalAlignment="Top"
                    Background="{StaticResource BACK}"
                    CornerRadius="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.5*" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Margin="0,20,0,0"
                            VerticalAlignment="Top"
                            FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="{StaticResource TEXTCOLOR}"
                            TextAlignment="center">
                            Califica de 1 a 5 tu nivel de satisfacción
                        </TextBlock>
                        <ListBox
                            x:Name="DataView"
                            Grid.Row="1"
                            Width="auto"
                            Height="auto"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Background="#0f0f"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource NoHighlightListBoxItemStyle}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="120" Orientation="Vertical">
                                        <Image
                                            Width="80"
                                            MouseDown="BtnCalificacion_TouchDown"
                                            Style="{StaticResource ConditionalStart}"
                                            Tag="{Binding Number}" />
                                        <TextBlock
                                            FontFamily="{StaticResource CENTURY_GOTHIC_BOLD}"
                                            FontSize="25"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource TITLECOLOR}"
                                            Text="{Binding Number}"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            FontFamily="{StaticResource CENTURY_GOTHIC}"
                                            FontSize="18"
                                            Foreground="{StaticResource TEXTCOLOR}"
                                            Text="{Binding Label}"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid
                    Grid.Row="6"
                    Grid.RowSpan="2"
                    Margin="0,49,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="123*" />
                        <ColumnDefinition Width="617*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.ColumnSpan="2"
                        Margin="0,145,0,0"
                        MouseDown="BtnSalir_MouseDown"
                        Style="{StaticResource ConditionalButton}" />


                </Grid>
            </Grid>
            <Image Margin="804,88,22,28" Grid.Row="2" Source="/Assets/Images/Logos/LogoDev.png" Stretch="Fill"/>
            <Image Margin="48,81,798,17" Grid.Row="2" Source="/Assets/Images/Logos/ico_linea_atencion_kiscos.png" Stretch="Fill"/>




        </Grid>


    </Viewbox>
</bases:AppUserControl>
