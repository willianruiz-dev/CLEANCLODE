<local:TouchableControl
    x:Class="UI.Components.RoundedButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UI.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Button"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Viewbox
        Width="Auto"
        Height="Auto"
        Stretch="Uniform">
        <Border Background="{Binding Color, ElementName=Button}" Style="{StaticResource BorderStyle}">
            <Grid>
                <TextBlock Style="{StaticResource TextBoxButtonStyle}" Text="{Binding Title, ElementName=Button}" />
            </Grid>
        </Border>
    </Viewbox>
</local:TouchableControl>
