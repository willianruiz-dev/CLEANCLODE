<Window
    x:Class="UI.Modals.BillReportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="BillReportWindow"
    Width="1080"
    Height="1920"
    Topmost="False"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">
    <Viewbox x:Name="WindowVB" Stretch="Uniform">
        <Grid Width="1080" Height="1920">
            <Grid.Background>
                <ImageBrush ImageSource="{StaticResource GENERIC}" Stretch="Uniform" />
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="4*" />
                <RowDefinition Height="1.5*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="1"
                Margin="50,0"
                Background="{StaticResource LIGTHCOLOR}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="4*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Image
                        Grid.Row="0"
                        Width="600"
                        Height="180"
                        VerticalAlignment="Center"
                        Source="{StaticResource LOGO}" />

                    <ListBox
                        x:Name="DataView"
                        Grid.Row="1"
                        Grid.ColumnSpan="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#0f0f"
                        BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="1080">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>


                                    <!--  Columna de Fecha pago  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        FontSize="30"
                                        FontWeight="Bold"
                                        Style="{StaticResource ViewBoxTextStyle}"
                                        Text="{Binding Key}" />
                                    <!--  Columna de Total  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        FontSize="30"
                                        Style="{StaticResource ViewBoxTextStyle}"
                                        Text="{Binding Value}" />
                                    <!--  Columna de Selecione  -->


                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        FontSize="50"
                        FontWeight="Bold"
                        Style="{StaticResource MessageTextStyle}"
                        Text="E-City Software" />

                </Grid>
            </Border>

            <TextBlock
                Grid.Row="2"
                Width="798"
                Height="80"
                Margin="0,22,0,0"
                FontWeight="Bold"
                Foreground="{StaticResource ERRORCOLOR}"
                Style="{StaticResource MessageTextStyle}"
                Text="Hubo un error durante el proceso de impresion. ¿Desea intentar imprimir?" />

            <Grid Grid.Row="2" Height="300">
                <Grid
                    x:Name="BtnNo"
                    Height="96"
                    Margin="150,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    PreviewMouseDown="BtnClose_MouseDown"
                    Visibility="Visible">
                    <Image Width="300" Source="{StaticResource cancelButtons}" />
                </Grid>
                <Grid
                    x:Name="BtnYes"
                    Margin="0,0,150,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    PreviewMouseDown="BtnClose_MouseDown">
                    <Border
                        HorizontalAlignment="Right"
                        Style="{StaticResource BorderStyle}"
                        Visibility="Visible">
                        <Grid>
                            <TextBlock
                                x:Name="TxtBtn1"
                                Style="{StaticResource TextBoxButtonStyle}"
                                Text="Aceptar" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Image
                Grid.Row="2"
                Margin="48,336,826,39"
                Source="/Assets/Images/Logos/ico_linea_atencion_kiscos.png"
                Stretch="Fill" />
            <Image
                Grid.Row="2"
                Margin="803,341,23,43"
                Source="/Assets/Images/Logos/LogoDev.png"
                Stretch="Fill" />
        </Grid>

    </Viewbox>
</Window>
