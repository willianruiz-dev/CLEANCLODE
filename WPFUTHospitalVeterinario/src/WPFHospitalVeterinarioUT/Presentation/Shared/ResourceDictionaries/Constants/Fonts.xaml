    <SolidColorBrush x:Key="TEXTCOLOR" Color="#2b2f34" />





    <FontFamily x:Key="CENTURY_GOTHIC_BOLD">pack://application:,,,/Assets/Fonts/Gothic/centurygothic_bold.ttf#Century Gothic</FontFamily>
    <FontFamily x:Key="CENTURY_GOTHIC">pack://application:,,,/Assets/Fonts/Gothic/centurygothic.ttf#Century Gothic</FontFamily>
    <FontFamily x:Key="MONSERRAT">pack://application:,,,/Assets/Fonts/Montserrat/Montserrat-VariableFont_wght.ttf#Montserrat</FontFamily>

</ResourceDictionary>