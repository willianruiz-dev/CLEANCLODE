<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!--  Aplication Colors  -->

    <SolidColorBrush x:Key="PRIMARYCOLOR" Color="#dc272d" />
    <!--<SolidColorBrush x:Key="SECONDARYCOLOR" Color="#FFFFFF"/>-->
    <SolidColorBrush x:Key="SECONDARYCOLOR" Color="#00A859" />
    <SolidColorBrush x:Key="TECLADO" Color="#213a48" />

    <!--  Foregrounds  -->
    <SolidColorBrush x:Key="LIGTHCOLOR" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GRAYTHEME" Color="#6c6f71" />
    <SolidColorBrush x:Key="ERRORCOLOR" Color="#b5202b" />
    <SolidColorBrush x:Key="SUCCESSCOLOR" Color="#2da047" />
    <SolidColorBrush x:Key="BACK" Color="#FFF" />
    <SolidColorBrush x:Key="STARTNORMAL" Color="#999c9d" />
