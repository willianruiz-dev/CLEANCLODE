<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Estilo para TextBox  -->
    <Style x:Key="TextBoxStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="10" />
        <Setter Property="BorderBrush" Value="{StaticResource BACK}" />
        <Setter Property="Foreground" Value="{StaticResource TEXTCOLOR}" />
        <Setter Property="FontFamily" Value="{StaticResource CENTURY_GOTHIC}" />
        <Setter Property="Background" Value="{StaticResource BACK}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="70" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Width" Value="659" />
        <Setter Property="FontSize" Value="30" />
    </Style>
    <Style x:Key="TextBoxStyleTwo" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BACK}" />
        <Setter Property="BorderBrush" Value="{StaticResource BACK}" />
        <Setter Property="Height" Value="100" />
        <Setter Property="FontFamily" Value="{StaticResource CENTURY_GOTHIC}" />
        <Setter Property="Foreground" Value="{StaticResource TEXTCOLOR}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Width" Value="580" />
        <Setter Property="FontSize" Value="40" />
    </Style>
    <Style x:Key="TextBoxButtonStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BACK}" />
        <Setter Property="FontFamily" Value="{StaticResource MONSERRAT}" />
        <Setter Property="FontSize" Value="33" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />

    </Style>
</ResourceDictionary>