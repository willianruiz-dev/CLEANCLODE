<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:UI.Components"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro">
    <!--  Icon Keyboard Style  -->
    <Style x:Key="BasicImageStyle" TargetType="Image">
        <Setter Property="Width" Value="500" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Visible" />
    </Style>

    <Style x:Key="GifViewerStyle" TargetType="components:GifViewer">
        <Setter Property="Height" Value="1150" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FooterIcon" TargetType="Image">
        <Setter Property="Width" Value="300" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="Margin" Value="0,1790,0,0" />
    </Style>

    <Style x:Key="ProgressRingStyle" TargetType="mah:ProgressRing">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{StaticResource PRIMARYCOLOR}" />
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="IsActive" Value="True" />
    </Style>

    <Style x:Key="FormInputField" TargetType="TextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="DefaultFormStyle"
        BasedOn="{StaticResource FormInputField}"
        TargetType="TextBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#0ff0" />
        <Setter Property="CaretBrush" Value="#0ff0" />
        <Setter Property="FontFamily" Value="{StaticResource MONSERRAT}" />
        <Setter Property="Foreground" Value="#000" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--  Estilo para Border  -->
    <Style x:Key="BorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="45" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Width" Value="321" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.0" Color="#9e080e" />
                    <GradientStop Offset="1.0" Color="#ee1d23" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NoHighlightListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        Name="Border"
                        Padding="2"
                        SnapsToDevicePixels="true">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>