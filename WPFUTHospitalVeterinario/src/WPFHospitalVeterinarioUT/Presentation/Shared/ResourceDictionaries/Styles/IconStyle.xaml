<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!--  Icon Keyboard Style  -->
    <Style x:Key="IconKeyboardStyle" TargetType="md:PackIcon">
        <Setter Property="Kind" Value="ChevronLeft" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource BACK}" />
        <Setter Property="Width" Value="65" />
        <Setter Property="Height" Value="65" />
    </Style>

    <Style x:Key="IconKeyboardStyleTwo" TargetType="md:PackIcon">
        <Setter Property="Kind" Value="ChevronLeft" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource BACK}" />
        <Setter Property="Width" Value="65" />
        <Setter Property="Height" Value="65" />
    </Style>

    <Style x:Key="logoHeaderStyle" TargetType="Image">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Width" Value="410" />
        <Setter Property="Margin" Value="0,40,0,0" />
        <Setter Property="Height" Value="180" />
    </Style>
</ResourceDictionary>